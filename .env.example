# ---------- Database (Neon PostgreSQL) ----------
# Leave empty to run in in-memory DEMO mode (data resets on restart).
# Neon: Project -> Connection Details -> copy the pooled connection string.
DATABASE_URL=

# ---------- Auth ----------
# REQUIRED in production. Generate with: openssl rand -base64 48
AUTH_SECRET=

# First-run account seeding.
# Demo mode (no DATABASE_URL): demo accounts are created with SEED_PASSWORD or "Sentinel@2026".
# Production: accounts are created ONLY if SEED_PASSWORD is set. Change the password after first login.
SEED_PASSWORD=
SEED_ADMIN_EMAIL=
# Set to "false" in production to skip demo scans/complaints/cases.
SEED_DEMO_DATA=true

# ---------- AI (Google Gemini) ----------
# Get a key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Model names are retired often; the app also tries a fallback chain.
GEMINI_MODEL=

# ---------- Image storage (Cloudinary) ----------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Show demo-login chips on /login even when a database is connected (not recommended in production).
NEXT_PUBLIC_SHOW_DEMO_LOGINS=false
